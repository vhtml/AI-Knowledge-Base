# 可选文本模型；留空 API key 时使用规则模式。真实密钥只写 Demos/.env。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Web 数据目录；CLI 使用 --data-dir。默认 ~/.study-planner。
# STUDY_PLANNER_DATA_DIR=/absolute/path/to/study-planner
# 仅创建新库时采用；已有库保留 profile.timezone。
STUDY_PLANNER_TIMEZONE=Asia/Shanghai
STUDY_PLANNER_CONTEXT_WINDOW=8000
STUDY_PLANNER_INPUT_BUDGET=6000
STUDY_PLANNER_OUTPUT_BUDGET=1500
