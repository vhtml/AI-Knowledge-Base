{
  "description": "kb-note-writer 的触发评测集。正例=该触发，负例=不该触发。kind=clear 表示明显该触发，near-miss 表示字面接近但语义不该触发。",
  "trigger_terms": [
    "笔记",
    "沉淀",
    "整理成文档",
    "记一笔",
    "知识库",
    "经验",
    "归档",
    "写进"
  ],
  "guard_terms": [
    "代码",
    "脚本",
    "爬虫",
    "PRD",
    "技术方案",
    "审查"
  ],
  "cases": [
    { "query": "帮我把这次踩坑写成笔记", "should_trigger": true, "kind": "clear" },
    { "query": "沉淀一篇 RAG 的经验", "should_trigger": true, "kind": "clear" },
    { "query": "整理成文档放进知识库", "should_trigger": true, "kind": "clear" },
    { "query": "记一笔这个坑", "should_trigger": true, "kind": "clear" },
    { "query": "写篇笔记讲讲 LangGraph 的持久化", "should_trigger": true, "kind": "clear" },
    { "query": "把这次经验沉淀一下", "should_trigger": true, "kind": "clear" },
    { "query": "归档到 AI 目录的知识笔记", "should_trigger": true, "kind": "clear" },
    { "query": "写进知识库吧", "should_trigger": true, "kind": "clear" },
    { "query": "整理成文档发我", "should_trigger": true, "kind": "clear" },
    { "query": "帮我把这几条经验归档", "should_trigger": true, "kind": "clear" },

    { "query": "帮我写个爬虫", "should_trigger": false, "kind": "near-miss" },
    { "query": "帮我写个爬虫，最后整理成文档", "should_trigger": false, "kind": "near-miss" },
    { "query": "帮我 review 这段代码并记一笔", "should_trigger": false, "kind": "near-miss" },
    { "query": "帮我 review 这段代码", "should_trigger": false, "kind": "clear" },
    { "query": "写一个 PDF 解析脚本", "should_trigger": false, "kind": "clear" },
    { "query": "今天的天气怎么样", "should_trigger": false, "kind": "clear" },
    { "query": "翻译这段英文", "should_trigger": false, "kind": "clear" },
    { "query": "帮我看下这个报错怎么修", "should_trigger": false, "kind": "clear" },
    { "query": "生成一份产品 PRD", "should_trigger": false, "kind": "clear" },
    { "query": "整理一下这个文件夹", "should_trigger": false, "kind": "near-miss" }
  ]
}
