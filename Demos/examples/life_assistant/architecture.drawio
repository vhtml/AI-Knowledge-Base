      <mxGeometry x="100" y="690" width="1000" height="170" as="geometry" />
    </mxCell>
    <mxCell id="c17" value="get_weather&lt;br>city（必填）&lt;br>day · unit" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;fontColor=#333333;" vertex="1" parent="L5">
