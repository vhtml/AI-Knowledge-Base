      <mxGeometry x="100" y="890" width="1000" height="160" as="geometry" />
    </mxCell>
    <mxCell id="c25" value="Open-Meteo 天气&lt;br>地理编码 + 预报&lt;br>无需 API Key" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontColor=#333333;" vertex="1" parent="L6">
      <mxGeometry x="30" y="42" width="280" height="88" as="geometry" />
    </mxCell>
    <mxCell id="c26" value="FakeWeatherProvider&lt;br>离线假数据&lt;br>离线时替换真数据" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontColor=#333333;" vertex="1" parent="L6">
      <mxGeometry x="360" y="42" width="280" height="88" as="geometry" />
    </mxCell>
    <mxCell id="c27" value="时区与城市表&lt;br>zoneinfo + 70 个内置城市&lt;br>providers.py / cities.py" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontColor=#333333;" vertex="1" parent="L6">
      <mxGeometry x="690" y="42" width="280" height="88" as="geometry" />
    </mxCell>
    <mxCell id="R2" value="关键约定&lt;br>&lt;br>① 工具选择有两条路径&lt;br>模型 function calling 为主，规则路由兜底&lt;br>两者实现同一套 plan() / continue_plan()&lt;br>接口，编排层不关心走哪条&lt;br>&lt;br>② 参数校验分三层&lt;br>schema 层拦下不合法参数 → 工具根本不执行&lt;br>工具内再校验（时区存在？城市查得到？）&lt;br>执行期兜底（ToolError → 工具结果）&lt;br>&lt;br>③ 错误要能回喂&lt;br>校验失败点名字段 + 给下一步建议&lt;br>模型读到后自己改参数重调一次&lt;br>缺参数且推不出来 → 回问用户" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;spacingLeft=12;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="1180" y="20" width="340" height="350" as="geometry" />
    </mxCell>
    <mxCell id="R1" value="OpenAI 兼容接口&lt;br>&lt;br>chat.completions.create + tools&lt;br>LLM_BASE_URL / LLM_API_KEY / LLM_MODEL&lt;br>&lt;br>不支持 function calling 时自动退回规则路由" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;spacingLeft=12;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="1180" y="400" width="340" height="150" as="geometry" />
    </mxCell>
    <mxCell id="R3" value="外部依赖&lt;br>&lt;br>Open-Meteo：geocoding + forecast，无需 Key&lt;br>zoneinfo：系统时区库&lt;br>&lt;br>离线模式：假天气数据&lt;br>不出网、不消耗 token" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;spacingLeft=12;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="1180" y="890" width="340" height="160" as="geometry" />
    </mxCell>
