    <mxCell id="c5" value="LifeAssistant.handle()&lt;br>选工具 → 校验 → 执行 → 回答&lt;br>（最多 6 轮，结果回填后继续）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;fontColor=#333333;" vertex="1" parent="L2">
