      <mxGeometry x="390" y="44" width="300" height="88" as="geometry" />
    </mxCell>
    <mxCell id="c7" value="执行与兜底&lt;br>ToolError → 工具结果&lt;br>异常不打断整轮对话" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;fontColor=#333333;" vertex="1" parent="L2">
      <mxGeometry x="730" y="44" width="240" height="88" as="geometry" />
    </mxCell>
    <mxCell id="L3" value="选择层 · planners.py（谁来选工具）" style="swimlane;startSize=32;horizontal=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;fontColor=#333333;rounded=1;arcSize=6;" vertex="1" parent="1">
