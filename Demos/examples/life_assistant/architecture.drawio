      <mxGeometry x="30" y="44" width="290" height="88" as="geometry" />
    </mxCell>
    <mxCell id="c10" value="RouterPlanner&lt;br>关键词规则 + 槽位抽取&lt;br>离线兜底 / 修复 / 追问" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;fontColor=#333333;" vertex="1" parent="L3">
