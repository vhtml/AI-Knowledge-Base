        <mxCell id="e6" value="recall() 召回记忆" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=0;convertToSvg=1;svgWhiteSpace=wrap;exitX=0.9815;exitY=1.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_handle" target="c_manager">
