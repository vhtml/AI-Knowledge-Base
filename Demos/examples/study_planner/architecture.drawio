          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="跑复盘" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=0;convertToSvg=1;svgWhiteSpace=wrap;exitX=0.7407;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5385;entryY=0.0000;entryDx=0;entryDy=0;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_handle" target="c_review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="promote() 强信号晋升" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=0;convertToSvg=1;svgWhiteSpace=wrap;exitX=0.1038;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_review" target="c_long">
