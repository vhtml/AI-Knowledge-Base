        <mxCell id="e2" value="起线程 · 调 handle()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=0;convertToSvg=1;svgWhiteSpace=wrap;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_worker" target="c_handle">
