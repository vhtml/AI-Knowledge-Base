          <mxGeometry x="20" y="48" width="460" height="68" as="geometry" />
        </mxCell>
        <mxCell id="c_worker" value="工作线程 + 队列&#10;Agent 是同步的，不能阻塞事件循环&#10;SessionStore：会话状态全局一份，写操作串行化" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;convertToSvg=1;svgWhiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;fontColor=#333333;" vertex="1" parent="L2">
          <mxGeometry x="510" y="48" width="570" height="68" as="geometry" />
        </mxCell>

        <mxCell id="L3" value="编排与领域层 · agent.py / planner.py / review.py" style="swimlane;startSize=32;horizontal=1;html=0;convertToSvg=1;svgWhiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;fontColor=#333333;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="380" width="1100" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c_handle" value="handle() 编排 · 每轮流程&#10;召回 → 执行 → 回写　|　detect_intent() 意图路由　|　每请求 reporter（作用域切换，SSE 各请求独立）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;convertToSvg=1;svgWhiteSpace=wrap;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontColor=#333333;" vertex="1" parent="L3">
          <mxGeometry x="20" y="48" width="1080" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c_planner" value="planner.py · 计划拆解&#10;目标 → 阶段 → 每日待办&#10;规则拆解：每日限量 · 末尾留白" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;convertToSvg=1;svgWhiteSpace=wrap;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontColor=#333333;" vertex="1" parent="L3">
          <mxGeometry x="20" y="140" width="480" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c_review" value="review.py · 每日复盘&#10;对账 · 找规律 · 沉淀&#10;摘要进短期，只有强信号才进长期" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;convertToSvg=1;svgWhiteSpace=wrap;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontColor=#333333;" vertex="1" parent="L3">
          <mxGeometry x="540" y="140" width="520" height="58" as="geometry" />
        </mxCell>

        <mxCell id="L4" value="记忆层 · memory.py　★ 本示例重点" style="swimlane;startSize=32;horizontal=1;html=0;convertToSvg=1;svgWhiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;fontColor=#333333;strokeWidth=2;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="640" width="1100" height="300" as="geometry" />
        </mxCell>
        <mxCell id="c_short" value="ShortTermMemory 短期工作区&#10;当天有效 · 满了折叠成摘要&#10;跨天清空 · 重复提及累加" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;convertToSvg=1;svgWhiteSpace=wrap;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;fontColor=#333333;" vertex="1" parent="L4">
          <mxGeometry x="30" y="44" width="340" height="84" as="geometry" />
        </mxCell>
        <mxCell id="c_long" value="LongTermMemory 长期档案&#10;跨会话保留 · 槽位去重&#10;同一件事只留最新说法，旧的仍可追溯" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;convertToSvg=1;svgWhiteSpace=wrap;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;fontColor=#333333;" vertex="1" parent="L4">
          <mxGeometry x="520" y="44" width="340" height="84" as="geometry" />
        </mxCell>
        <mxCell id="c_score" value="tokenize · recall_score&#10;中文按二元组切分&#10;打分：词片重合 + 重要度 + 新鲜度 + 频次" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;convertToSvg=1;svgWhiteSpace=wrap;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;fontColor=#333333;" vertex="1" parent="L4">
          <mxGeometry x="30" y="180" width="340" height="84" as="geometry" />
        </mxCell>
        <mxCell id="c_manager" value="MemoryManager 门面&#10;remember · recall · promote · rollover&#10;长期记忆只能经 promote() 写入" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;convertToSvg=1;svgWhiteSpace=wrap;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;fontColor=#333333;" vertex="1" parent="L4">
          <mxGeometry x="520" y="180" width="340" height="84" as="geometry" />
        </mxCell>

        <mxCell id="L5" value="存储层 · storage.py（JSON 持久化）" style="swimlane;startSize=32;horizontal=1;html=0;convertToSvg=1;svgWhiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;fontColor=#333333;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="990" width="1100" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c_json1" value="goals.json · plans.json&#10;目标与每日待办" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;convertToSvg=1;svgWhiteSpace=wrap;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontColor=#333333;" vertex="1" parent="L5">
          <mxGeometry x="20" y="48" width="520" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c_json2" value="reviews.json · memory.json&#10;复盘记录与两级记忆" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;convertToSvg=1;svgWhiteSpace=wrap;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontColor=#333333;" vertex="1" parent="L5">
          <mxGeometry x="580" y="48" width="500" height="72" as="geometry" />
        </mxCell>

        <mxCell id="R1" value="SSE 事件协议&#10;&#10;POST /api/chat → text/event-stream&#10;&#10;status　阶段提示&#10;step　　一条留痕（渲染&quot;这轮动了哪块记忆&quot;）&#10;reply　 回答正文&#10;state　 全量状态快照&#10;error　 错误说明&#10;&#10;留痕单独推事件，是为了让工作台&#10;把「召回 → 记录目标 → 长期记忆 → 回写」&#10;这条链路摊开给人看，而不是只给结论。&#10;&#10;EventSource 只支持 GET 且不能带 body，&#10;所以用 fetch + ReadableStream 自己切帧。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;convertToSvg=1;svgWhiteSpace=wrap;align=left;spacingLeft=12;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1220" y="20" width="340" height="320" as="geometry" />
        </mxCell>

        <mxCell id="R2" value="关键约定：两级记忆&#10;&#10;① 归属不同&#10;　服务端是唯一真相，快照整体替换&#10;　不做局部合并，避免留下脏数据&#10;&#10;② 长期记忆只能经 promote() 写入&#10;　每条都经过&quot;值得记住&quot;的判断&#10;&#10;③ 同一件事只留最新说法&#10;　槽位归一化去掉数字，&#10;　&quot;每天学 2 小时&quot;与&quot;3 小时&quot;同槽&#10;　旧的标记 superseded 但不删除&#10;&#10;④ 跨天先晋升再清空&#10;　顺序反了，值得沉淀的就丢了&#10;&#10;⑤ 时间预算是状态约束，不是话题&#10;　&quot;生成计划&quot;召不回&quot;每天 30 分钟&quot;&#10;　所以直接扫档案取，不靠相关性检索" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;convertToSvg=1;svgWhiteSpace=wrap;align=left;spacingLeft=12;verticalAlign=top;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1220" y="360" width="340" height="400" as="geometry" />
        </mxCell>

        <mxCell id="R3" value="数据目录与接口&#10;&#10;~/.study-planner/&#10;　goals.json　　plans.json&#10;　reviews.json　memory.json&#10;&#10;STUDY_PLANNER_DATA_DIR 可改目录&#10;&#10;接口&#10;　GET　/health　　　　健康检查&#10;　GET　/api/state　　 全量快照&#10;　POST /api/chat　　 SSE 对话&#10;　POST /api/tasks/{id}/toggle&#10;　POST /api/goals　　建目标并排计划&#10;　POST /api/rollover　模拟跨天&#10;　POST /api/reset　　清空数据" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;convertToSvg=1;svgWhiteSpace=wrap;align=left;spacingLeft=12;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1220" y="780" width="340" height="350" as="geometry" />
        </mxCell>

        <mxCell id="F1" value="数据流：用户输入 → api.js（POST /api/chat）→ 工作线程调用 handle() → 召回记忆 → 执行（排计划 / 复盘）→ 回写记忆 → 留痕与回答经 SSE 逐条推回 → 状态快照刷新右侧面板" style="text;html=0;convertToSvg=1;svgWhiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="80" y="1160" width="1100" height="38" as="geometry" />
        </mxCell>

