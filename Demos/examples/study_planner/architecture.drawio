        <mxCell id="e_decide" value="① 决策：一次性拿 JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=0;convertToSvg=1;svgWhiteSpace=wrap;startArrow=block;startFill=1;endArrow=block;endFill=1;exitX=0.0926;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.2941;entryY=1.0000;entryDx=0;entryDy=0;strokeColor=#d79b00;strokeWidth=2;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_handle" target="c_decide">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_stream" value="② 流式回复" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=0;convertToSvg=1;svgWhiteSpace=wrap;startArrow=block;startFill=1;endArrow=block;endFill=1;exitX=0.6944;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.0882;entryY=1.0000;entryDx=0;entryDy=0;strokeColor=#d79b00;strokeWidth=2;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_handle" target="c_stream">
