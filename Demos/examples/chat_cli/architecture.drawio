    </mxCell>
    <mxCell id="R1" value="OpenAI 兼容接口&lt;br>&lt;br>chat.completions.create&lt;br>LLM_BASE_URL / LLM_API_KEY&lt;br>LLM_MODEL" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;spacingLeft=12;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="1150" y="500" width="350" height="150" as="geometry" />
    </mxCell>
    <mxCell id="R2" value="关键约定&lt;br>&lt;br>① 只有 role + content 进入模型上下文&lt;br>元数据留在本地，只服务展示与统计&lt;br>&lt;br>② 上下文 = 系统提示 + 历史摘要 + 近期原文&lt;br>按 token 预算动态装配，超出即裁剪&lt;br>&lt;br>③ 历史 = 完整事件流&lt;br>压缩只折叠，不删除任何消息" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;spacingLeft=12;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="1150" y="20" width="350" height="300" as="geometry" />
    </mxCell>
    <mxCell id="R3" value="会话目录&lt;br>&lt;br>~/.chat-cli/sessions/&lt;br>  &lt;id>.jsonl       事件流&lt;br>  &lt;id>.meta.json   元信息&lt;br>&lt;br>--session-dir 可改" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;spacingLeft=12;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="1150" y="680" width="350" height="180" as="geometry" />
